# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# META_PAGE_ACCESS_TOKEN & FB_PAGE_ACCESS_TOKEN:
# Both environment variable names are supported and kept in sync automatically.
META_PAGE_ACCESS_TOKEN="YOUR_META_PAGE_ACCESS_TOKEN"
FB_PAGE_ACCESS_TOKEN="YOUR_FB_PAGE_ACCESS_TOKEN"
META_PAGE_ID="109603071381200"
FB_PAGE_ID="109603071381200"

# SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY: the portal's own database (Supabase project "bpso-live-portal").
# Server-only secret key (Supabase → Project Settings → API keys → secret / service_role). Never put it in browser code.
# Without these the server falls back to temporary in-memory storage (data is lost between Vercel copies).
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SECRET_KEY"

# PORTAL_OWNER_CODE: the owner's sign-in code. Sign-in is switched on only when this and the database are set.
# The owner then creates phone sign-in links for the admins from "Admin Phone QR".
PORTAL_OWNER_CODE="CHOOSE-A-LONG-PRIVATE-CODE"

# META_APP_SECRET: verifies that webhook events really come from Meta (Meta app → Settings → Basic → App secret).
META_APP_SECRET="YOUR_META_APP_SECRET"
